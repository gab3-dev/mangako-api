MANGAKO_API_IMAGE=ghcr.io/gab3-dev/mangako-api@sha256:replace-with-published-image-digest
POSTGRES_DB=mangako_api
POSTGRES_USER=mangako
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
API_READ_TOKEN=replace-with-a-unique-32-character-read-token
API_WRITE_TOKEN=replace-with-a-different-32-character-write-token
MAX_JSON_BODY_BYTES=65536
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_MAX_CLIENTS=10000
TRUST_PROXY_HEADERS=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=1000
CACHE_MAX_BYTES=67108864
RUST_LOG=mangako_api=info,tower_http=info
